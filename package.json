{
  "name": "monorepo-boilerplate",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "prepare": "husky && bin/agents.link-skills.sh && node bin/agents.generate-subagents.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "deps:check": "depcruise --config config/dependency-cruiser.cjs apps packages templates",
    "openapi:generate": "turbo run openapi:generate",
    "openapi:check": "turbo run openapi:check",
    "docs:generate": "turbo run docs:generate",
    "docs:check": "turbo run docs:check",
    "docs:build": "turbo run build --filter=@apps/frontend.docs",
    "docs:dev": "turbo run dev --filter=@apps/frontend.docs",
    "docs:package": "turbo run docs:package --filter=@apps/frontend.docs",
    "agents:link-skills": "bin/agents.link-skills.sh",
    "agents:generate-subagents": "node bin/agents.generate-subagents.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@packages/eslint-config": "workspace:*",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,mjs,cjs,js,jsx}": [
      "prettier --write",
      "eslint --config config/eslint.config.fast.mjs --no-config-lookup --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
