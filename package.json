    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "shadcn": "^4.11.0",
    "skills": "^1.5.11",
    "turbo": "^2.9.18",
    "typescript": "6.0.3"
  }
