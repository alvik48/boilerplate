{
  "name": "@apps/frontend.docs",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3002",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node --import tsx scripts/generate.ts",
    "docs:prepare": "fumadocs-mdx",
    "docs:check": "node --import tsx scripts/check.ts",
    "docs:watch": "node --import tsx scripts/watch.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "docs:package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@packages/ui": "workspace:*",
    "lucide-react": "^1.14.0",
    "next": "16.2.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "fumadocs-core": "16.15.8",
    "fumadocs-ui": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-openapi": "11.4.1",
    "@packages/docs-core": "workspace:*",
    "@packages/api-contracts": "workspace:*",
    "@packages/mcp": "workspace:*",
    "zod": "4.4.3",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@packages/eslint-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "@types/mdx": "2.0.13",
    "@types/mdast": "4.0.4",
    "tsx": "4.21.0",
    "chokidar": "4.0.3",
    "@playwright/test": "1.58.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  }
}
