# PostgreSQL connection string used by Prisma CLI commands.
# This file is loaded by prisma.config.ts via dotenv when running:
#   pnpm --filter @packages/db-core prisma:migrate
#   pnpm --filter @packages/db-core prisma:reset
#   pnpm --filter @packages/db-core prisma:deploy
#   pnpm --filter @packages/db-core prisma:generate
POSTGRES_URL=postgresql://user:password@127.0.0.1:5432/ww?schema=public
