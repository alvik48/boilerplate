// -----------------------------------------------------------------------------
// Configuration

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums

/*
Example:

enum SystemRole {
  Admin         @map("admin")
  Manager       @map("manager")
  User          @map("user")

  @@map("system_role")
}
*/

// -----------------------------------------------------------------------------
// Models

/*
Example:

model AppUser {
  id        Int      @id @map("id")
  createdAt DateTime @map("created_at_ts_sec") @default(now())
  updatedAt DateTime @map("updated_at_ts_sec") @updatedAt

  @@map("app_users")
}
*/
