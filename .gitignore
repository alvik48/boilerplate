# Dependencies
node_modules/
/.pnpm-store/

# Build and compiler output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Test coverage
coverage/
/.nyc_output/

# Logs
/logs/*
!/logs/.gitkeep
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime and diagnostic files
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local data
/data/*
!/data/.gitkeep
apps/**/data/*
!apps/**/data/.gitkeep

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Generated output
generated/

# Temporary files
.temp
.tmp
/tmp/

# Editors and IDEs
.DS_Store
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code workspace settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI
/.claude/
/.codex/

# Temporary AI implementation plans
/.agents/plans/
